# Copy to .env and adjust. .env is gitignored — never commit real values.

# --- Sources ---------------------------------------------------------------
# Upstream Frappe Books app repository (public).
BOOKS_APP_REPO=https://github.com/frappe/frappe-books
# Optional branch/tag/commit to pin the app (empty = repository default).
BOOKS_APP_REF=develop
# Optional: use an existing local checkout instead of cloning BOOKS_APP_REPO.
# BOOKS_APP_SOURCE_DIR=/path/to/frappe-books

# Frappe framework branch used by `bench init` (develop == v17 dev line).
BOOKS_FRAPPE_BRANCH=develop

# --- Site / server ---------------------------------------------------------
BOOKS_SITE=site1
BOOKS_PORT=8020
BOOKS_ADMIN_USER=Administrator
BOOKS_ADMIN_PASSWORD=admin

# --- Redis (bundled with the app) ------------------------------------------
BOOKS_REDIS_QUEUE_PORT=11000
BOOKS_REDIS_CACHE_PORT=13000

# --- Build -----------------------------------------------------------------
BOOKS_DIST_DIR=dist
